# ---------------------------------------------------------------------------
# Core / server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://secondand15:secondand15@localhost:5432/secondand15?schema=public
LOG_LEVEL=info

# Optional, explicit marker for which real environment DATABASE_URL points at.
# Not required for the app to run. If set to "production", database-backed
# tests refuse to run at all (see TEST_DATABASE_URL below), regardless of
# which URL they'd otherwise use. See docs/testing/database-tests.md.
# DATABASE_ENVIRONMENT=development

# Required only to run database-backed integration tests
# (`RUN_DATABASE_TESTS=true npm test`). Must be a genuinely separate database
# or Neon branch -- never copy DATABASE_URL's value here. Tests refuse to run
# under NODE_ENV=test if this is unset, blank, or identical to DATABASE_URL.
# See docs/testing/database-tests.md for how to provision one.
# TEST_DATABASE_URL=postgresql://secondand15:secondand15@localhost:5432/secondand15_test?schema=public

# Reverse proxy trust. Production behind a single load balancer/reverse proxy
# should set this to the number of trusted hops (usually 1). Do NOT set to
# "true" or "*" -- that trusts every X-Forwarded-For hop a client can spoof.
# A comma-separated list of trusted proxy IPs/CIDRs is also accepted.
# See docs/production/deployment.md.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# CORS / rate limiting
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Auth (JWT access tokens + rotating refresh-token sessions)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=secondand15_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Forgot / reset password
# ---------------------------------------------------------------------------
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_TOKEN_TTL=30m
# Must be https:// in production.
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------
# development: logs/stores messages in-memory, never sends real email.
# resend: sends real email via the Resend API (requires RESEND_API_KEY).
EMAIL_PROVIDER=development
EMAIL_DEV_LOG_RESET_URL=false
RESEND_API_KEY=
EMAIL_FROM=2nd & 15 <support@2ndand15.com>

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Operator inbox that receives public contact-form notifications.
CONTACT_TO_EMAIL=
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# Editorial AI (article drafting assistance)
# ---------------------------------------------------------------------------
EDITORIAL_AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_EDITORIAL_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
EDITORIAL_AI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Sports data / season configuration
# ---------------------------------------------------------------------------
SPORTS_PROVIDER=mock
CURRENT_NFL_SEASON=2026
# Must be false in production.
ALLOW_HISTORICAL_DEFAULT_GAME_RESULTS=false
# Must be false in production -- prevents fictional fixture games from being
# publicly served.
FIXTURE_DATA_ENABLED=false
SPORTS_API=
API_SPORTS_BASE_URL=https://v1.american-football.api-sports.io
API_SPORTS_REQUEST_TIMEOUT_MS=10000
API_SPORTS_MAX_RETRIES=2
API_SPORTS_SYNC_SEASON=2026
API_SPORTS_SYNC_SEASON_TYPE=ALL
API_SPORTS_STORE_LOGO_URLS=false

# ---------------------------------------------------------------------------
# News ingestion policy
# ---------------------------------------------------------------------------
NEWS_INITIAL_INGEST_LOOKBACK_HOURS=72
NEWS_INITIAL_INGEST_MAX_ITEMS_PER_SOURCE=25
NEWS_LATE_ITEM_TOLERANCE_HOURS=48

# ---------------------------------------------------------------------------
# Game Center curated video embeds
# ---------------------------------------------------------------------------
GAME_CURATED_VIDEO_EMBED_HOST_ALLOWLIST=youtube.com,www.youtube.com,youtube-nocookie.com,www.youtube-nocookie.com

# ---------------------------------------------------------------------------
# Highlightly current-game provider
# ---------------------------------------------------------------------------
CURRENT_GAME_PROVIDER=highlightly
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_BASE_URL=https://american-football.highlightly.net
HIGHLIGHTLY_REQUEST_TIMEOUT_MS=10000
HIGHLIGHTLY_MAX_RETRIES=1
HIGHLIGHTLY_EVALUATION_SEASON=2026
# Exactly one of these two must be true. Evaluation mode is for pre-production
# review; publication-approved is the production go-live flag.
HIGHLIGHTLY_EVALUATION_MODE=true
HIGHLIGHTLY_PUBLICATION_APPROVED=false
HIGHLIGHTLY_EMBED_HOST_ALLOWLIST=youtube.com,www.youtube.com,youtube-nocookie.com,www.youtube-nocookie.com
# Global public-API kill-switch for highlight embed playback. Keep false until
# real playback is confirmed working (see HIGHLIGHTLY_EMBED_HOST_ALLOWLIST
# comment in src/config/env.ts).
HIGHLIGHTLY_EMBED_PLAYBACK_ENABLED=false

# ---------------------------------------------------------------------------
# Current-game live poller / worker
# ---------------------------------------------------------------------------
# Master enable switch for broad (non --gameId/--dry-run) polling and for the
# long-running worker (src/workers/current-game-worker.ts).
CURRENT_GAME_POLLER_ENABLED=true
CURRENT_GAME_POLLER_HEARTBEAT_SECONDS=20
CURRENT_GAME_POLLER_BATCH_SIZE=10
CURRENT_GAME_POLLER_LOCK_LEASE_SECONDS=120
CURRENT_GAME_PREGAME_POLL_SECONDS=300
CURRENT_GAME_LIVE_POLL_SECONDS=120
CURRENT_GAME_FEATURED_POLL_SECONDS=60
CURRENT_GAME_HALFTIME_POLL_SECONDS=180
# Independent `/box-score/{id}` cadence. Applies to LIVE and HALFTIME; FINAL
# reconciliation stages always request one authoritative refresh.
CURRENT_GAME_PLAYER_STATS_POLL_SECONDS=120
CURRENT_GAME_FINAL_RECONCILE_10_MINUTES=10
CURRENT_GAME_FINAL_RECONCILE_60_MINUTES=60
CURRENT_GAME_RATE_LIMIT_DEGRADE_THRESHOLD=500
