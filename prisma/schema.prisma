model Article {
  id                      String                  @id @default(uuid()) @db.Uuid
  slug                    String                  @unique(map: "articles_slug_key") @db.VarChar(160)
  type                    ArticleType
  status                  ArticleStatus           @default(DRAFT)
  version                 Int                     @default(1)
  title                   String                  @db.VarChar(180)
  summary                 String?                 @db.VarChar(1000)
  body                    String?                 @db.Text
