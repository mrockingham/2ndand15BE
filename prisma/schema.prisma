  classificationInputTokens  Int?                     @map("classification_input_tokens")
  classificationOutputTokens Int?                     @map("classification_output_tokens")
  classificationDurationMs   Int                      @default(0) @map("classification_duration_ms")
  overridden                 Boolean                  @default(false)
  overrideReason             String?                  @map("override_reason") @db.VarChar(500)
  evaluatedById              String?                  @map("evaluated_by_id") @db.Uuid
  evaluatedBySnapshot        String?                  @map("evaluated_by_snapshot") @db.VarChar(254)
  evaluatedAt                DateTime                 @map("evaluated_at") @db.Timestamptz(3)
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  candidate                  NewsCandidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evaluator                  User?                    @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@index([decision, qualityScore, candidateId], map: "candidate_quality_decision_score_idx")
