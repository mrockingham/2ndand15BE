model HistoricalImportFile {
  id               String                 @id @default(uuid()) @db.Uuid
  runId            String                 @map("run_id") @db.Uuid
  datasetId        String                 @map("dataset_id") @db.Uuid
  leaseKey         String                 @map("lease_key") @db.VarChar(64)
  status           HistoricalImportStatus @default(RUNNING)
  checksumSha256   String                 @map("checksum_sha256") @db.Char(64)
  fileSizeBytes    BigInt                 @map("file_size_bytes")
  downloadedAt     DateTime?              @map("downloaded_at") @db.Timestamptz(3)
  sourceRowCount   Int                    @default(0) @map("source_row_count")
  acceptedRowCount Int                    @default(0) @map("accepted_row_count")
  createdCount     Int                    @default(0) @map("created_count")
  updatedCount     Int                    @default(0) @map("updated_count")
  skippedCount     Int                    @default(0) @map("skipped_count")
  warningCount     Int                    @default(0) @map("warning_count")
  failureCount     Int                    @default(0) @map("failure_count")
  schemaReport     Json?                  @map("schema_report")
  reconciliation   Json?
  startedAt        DateTime               @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?              @map("completed_at") @db.Timestamptz(3)
  run              HistoricalImportRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  dataset          HistoricalDataset      @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@index([datasetId, checksumSha256], map: "historical_import_files_dataset_checksum_idx")
  @@index([runId, status], map: "historical_import_files_run_status_idx")
  @@map("historical_import_files")
}
