generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum League {
  NFL
}

enum Conference {
  AFC
  NFC
}

enum Division {
  East
  North
  South
  West
}

enum SeasonType {
  PRE
  REG
  POST
}

enum GameStatus {
  SCHEDULED
  PREGAME
  IN_PROGRESS
  HALFTIME
  FINAL
  POSTPONED
  CANCELED
  SUSPENDED
}

enum GamePlayType {
  PASS
  RUSH
  PUNT
  KICKOFF
  FIELD_GOAL
  SACK
  PENALTY
  TIMEOUT
  INTERCEPTION
  FUMBLE
  END_PERIOD
  OTHER
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum GameSourceType {
  MANUAL_IMPORT
  MANUAL_ENTRY
  OFFICIAL_WEB
  PROVIDER
  EDITORIAL_OVERRIDE
  DEVELOPMENT_FIXTURE
}

enum ArticleType {
  ORIGINAL
  CURATED
  ANNOUNCEMENT
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum NewsSourceKind {
  RSS
  ATOM
  MANUAL_ONLY
}

enum NewsSourceStatus {
  ACTIVE
  PAUSED
  DISABLED
  ERROR
}

enum NewsCandidateStatus {
  NEW
  REVIEWING
  SAVED
  CONVERTED
  DISMISSED
}

enum NewsIngestionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum EditorialAiConfidence {
  HIGH
  MEDIUM
  LOW
}

enum EditorialAiReviewStatus {
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum CandidateRelevance {
  NFL
  NOT_NFL
  UNCERTAIN
}

enum CandidateSufficiency {
  FULL_DRAFT_ELIGIBLE
  SHORT_BRIEF_ELIGIBLE
  LINK_ONLY
  INSUFFICIENT
  MANUAL_REVIEW
}

enum CandidateQualityDecision {
  NFL_RELEVANT_FULL_DRAFT
  NFL_RELEVANT_SHORT_BRIEF
  NFL_RELEVANT_LINK_ONLY
  REJECT_NON_NFL
  REJECT_DUPLICATE
  REJECT_INSUFFICIENT
  NEEDS_MANUAL_REVIEW
}

enum EditorialCategory {
  BREAKING_NEWS
  TRAINING_CAMP
  PRESEASON
  GAME
  INJURY
  TRANSACTION
  CONTRACT
  ROSTER
  TRADE
  PLAYER
  TEAM
  ANALYSIS
  FANTASY
  LEAGUE
  OFF_FIELD
}

enum EditorialRiskFlag {
  THIN_SOURCE
  POSSIBLE_DUPLICATE
  SENSITIVE_INJURY
  CONTRACT_FIGURES
  LEGAL_DISCIPLINARY
  TRADE_RUMOR
  UNSOURCED_CLAIM
  QUOTE_INCLUDED
  MEDIA_RIGHTS_UNCLEAR
  PLAYER_IDENTITY_UNCERTAIN
  SOURCE_OVERLAP
}

enum StoryOverlapStatus {
  UNIQUE
  RELATED
  LIKELY_DUPLICATE
  DUPLICATE
}

enum SourceTextUsage {
  SUMMARY_ALLOWED
  LINK_ONLY
  UNKNOWN
}

enum SourceMediaUsage {
  OWNED
  EMBED_ALLOWED
  LINK_ONLY
  UNKNOWN
}

enum SourceQuotationPolicy {
  SHORT_QUOTES_ONLY
  UNKNOWN
}

enum ArticleMediaType {
  YOUTUBE
  VIDEO_EMBED
  IMAGE
  EXTERNAL_LINK
}

enum ArticleMediaStatus {
  SUGGESTED
  ATTACHED
  REJECTED
}

enum HistoricalDatasetKind {
  PLAYERS
  WEEKLY_ROSTERS
  PLAYER_STATS
  SCHEDULES
}

enum HistoricalImportStatus {
  RUNNING
  DRY_RUN
  SUCCEEDED
  PARTIAL
  FAILED
}

enum PlayerSeasonSummaryType {
  REG
  POST
  REG_POST
}

enum PredictionStatus {
  DRAFT
  PUBLISHED
  LOCKED
  EVALUATED
}

enum PredictionConfidence {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  email                       String                       @db.VarChar(254)
  normalizedEmail             String                       @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(254)
  passwordHash                String                       @map("password_hash") @db.VarChar(255)
  displayName                 String?                      @map("display_name") @db.VarChar(80)
  isActive                    Boolean                      @default(true) @map("is_active")
  role                        UserRole                     @default(USER)
  favoriteTeamId              String?                      @map("favorite_team_id") @db.Uuid
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                    Session[]
  passwordResetTokens         PasswordResetToken[]
  favoriteTeam                Team?                        @relation("UserFavoriteTeam", fields: [favoriteTeamId], references: [id], onDelete: SetNull)
  verifiedProvenances         GameProvenance[]             @relation("GameProvenanceVerifier")
  createdOverrides            GameEditorialOverride[]      @relation("GameOverrideCreator")
  updatedOverrides            GameEditorialOverride[]      @relation("GameOverrideUpdater")
  auditEvents                 AdminAuditEvent[]            @relation("AdminAuditActor")
  createdArticles             Article[]                    @relation("ArticleCreator")
  updatedArticles             Article[]                    @relation("ArticleUpdater")
  articleRevisions            ArticleRevision[]            @relation("ArticleRevisionEditor")
  createdNewsSources          NewsSource[]                 @relation("NewsSourceCreator")
  updatedNewsSources          NewsSource[]                 @relation("NewsSourceUpdater")
  reviewedCandidates          NewsCandidate[]              @relation("NewsCandidateReviewer")
  newsIngestionRuns           NewsIngestionRun[]           @relation("NewsIngestionInitiator")
  reviewedSourceRights        SourceRightsProfile[]        @relation("SourceRightsReviewer")
  evaluatedCandidateQualities CandidateQualityEvaluation[]
  generatedPredictions        GamePrediction[]             @relation("PredictionGenerator")

  @@index([isActive], map: "users_active_idx")
  @@index([favoriteTeamId], map: "users_favorite_team_id_idx")
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_state_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_hash_key") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt], map: "password_reset_tokens_user_state_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model Team {
  id                         String                  @id @default(uuid()) @db.Uuid
  league                     League
  city                       String                  @db.VarChar(64)
  name                       String                  @db.VarChar(64)
  fullName                   String                  @map("full_name") @db.VarChar(128)
  abbreviation               String                  @db.VarChar(8)
  conference                 Conference
  division                   Division
  primaryColor               String                  @map("primary_color") @db.VarChar(7)
  secondaryColor             String                  @map("secondary_color") @db.VarChar(7)
  logoUrl                    String?                 @map("logo_url") @db.Text
  logoSource                 String?                 @map("logo_source") @db.VarChar(128)
  isActive                   Boolean                 @default(true) @map("is_active")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  providerMaps               TeamProviderMapping[]
  homeGames                  Game[]                  @relation("HomeTeamGames")
  awayGames                  Game[]                  @relation("AwayTeamGames")
  favoritedBy                User[]                  @relation("UserFavoriteTeam")
  articles                   ArticleTeam[]
  defaultNewsSources         NewsSource[]
  newsCandidateSuggestions   NewsCandidateTeam[]
  latestPlayers              Player[]                @relation("PlayerLatestTeam")
  draftedPlayers             Player[]                @relation("PlayerDraftTeam")
  weeklyPlayerRosters        PlayerWeekRoster[]
  playerGameStats            PlayerGameStat[]        @relation("PlayerStatTeam")
  opponentPlayerGameStats    PlayerGameStat[]        @relation("PlayerStatOpponent")
  currentGameTeamStats       CurrentGameTeamStat[]
  currentPlayerGameStats     CurrentGamePlayerStat[] @relation("TeamCurrentGamePlayerStats")
  possessedGamePlays         GamePlay[]              @relation("GamePlayPossessionTeam")
  primaryEditorialDrafts     ArticleAiMetadata[]     @relation("EditorialPrimaryTeam")
  homePredictions            GamePrediction[]        @relation("PredictionHomeTeam")
  awayPredictions            GamePrediction[]        @relation("PredictionAwayTeam")
  predictedWinnerPredictions GamePrediction[]        @relation("PredictionWinnerTeam")
  actualWinnerPredictions    GamePrediction[]        @relation("PredictionActualWinnerTeam")

  @@unique([league, abbreviation], map: "teams_league_abbreviation_key")
  @@index([league, isActive, conference, division, fullName], map: "teams_catalog_order_idx")
  @@map("teams")
}

model Game {
  id                    String                         @id @default(uuid()) @db.Uuid
  league                League
  season                Int
  seasonType            SeasonType                     @map("season_type")
  week                  Int?
  startTime             DateTime?                      @map("start_time") @db.Timestamptz(3)
  status                GameStatus
  homeTeamId            String                         @map("home_team_id") @db.Uuid
  awayTeamId            String                         @map("away_team_id") @db.Uuid
  homeScore             Int?                           @map("home_score")
  awayScore             Int?                           @map("away_score")
  quarter               Int?
  clock                 String?                        @db.VarChar(16)
  venueName             String?                        @map("venue_name") @db.VarChar(160)
  venueCity             String?                        @map("venue_city") @db.VarChar(128)
  broadcastNetwork      String?                        @map("broadcast_network") @db.VarChar(64)
  isNeutralSite         Boolean                        @default(false) @map("is_neutral_site")
  providerLastUpdatedAt DateTime?                      @map("provider_last_updated_at") @db.Timestamptz(3)
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  homeTeam              Team                           @relation("HomeTeamGames", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam              Team                           @relation("AwayTeamGames", fields: [awayTeamId], references: [id], onDelete: Restrict)
  providerMaps          GameProviderMapping[]
  provenance            GameProvenance?
  editorialOverride     GameEditorialOverride?
  playerStats           PlayerGameStat[]
  currentTeamStats      CurrentGameTeamStat[]
  currentPlayerStats    CurrentGamePlayerStat[]
  currentPlayerCoverage CurrentGamePlayerStatCoverage?
  plays                 GamePlay[]
  predictions           GamePrediction[]

  @@index([league, season, seasonType, week, startTime], map: "games_schedule_idx")
  @@index([status, startTime], map: "games_status_start_time_idx")
  @@index([homeTeamId, startTime], map: "games_home_team_start_time_idx")
  @@index([awayTeamId, startTime], map: "games_away_team_start_time_idx")
  @@map("games")
}

model GamePlay {
  id                String       @id @default(uuid()) @db.Uuid
  gameId            String       @map("game_id") @db.Uuid
  playKey           String       @map("play_key") @db.Char(64)
  reconciliationKey String       @map("reconciliation_key") @db.Char(64)
  sequence          Int
  period            Int
  clock             String       @db.VarChar(8)
  possessionTeamId  String?      @map("possession_team_id") @db.Uuid
  playType          GamePlayType @map("play_type")
  description       String       @db.Text
  startDown         Int?         @map("start_down")
  startDistance     Int?         @map("start_distance")
  startYardLine     Int?         @map("start_yard_line")
  endDown           Int?         @map("end_down")
  endDistance       Int?         @map("end_distance")
  endYardLine       Int?         @map("end_yard_line")
  isScoringPlay     Boolean      @map("is_scoring_play")
  isPenalty         Boolean      @map("is_penalty")
  isTurnover        Boolean      @map("is_turnover")
  sourceProvider    String       @map("source_provider") @db.VarChar(64)
  sourcePlayType    String       @map("source_play_type") @db.VarChar(128)
  sourceUpdatedAt   DateTime     @map("source_updated_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  game              Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  possessionTeam    Team?        @relation("GamePlayPossessionTeam", fields: [possessionTeamId], references: [id], onDelete: Restrict)

  @@unique([gameId, playKey], map: "game_plays_game_play_key")
  @@unique([gameId, sequence], map: "game_plays_game_sequence_key")
  @@index([gameId, period, sequence], map: "game_plays_game_period_sequence_idx")
  @@index([gameId, reconciliationKey], map: "game_plays_game_reconciliation_idx")
  @@map("game_plays")
}

model GamePrediction {
  id                    String               @id @default(uuid()) @db.Uuid
  gameId                String               @map("game_id") @db.Uuid
  modelVersion          String               @map("model_version") @db.VarChar(64)
  revision              Int
  status                PredictionStatus     @default(DRAFT)
  homeTeamId            String               @map("home_team_id") @db.Uuid
  awayTeamId            String               @map("away_team_id") @db.Uuid
  predictedWinnerTeamId String?              @map("predicted_winner_team_id") @db.Uuid
  homeWinProbability    Float                @map("home_win_probability")
  awayWinProbability    Float                @map("away_win_probability")
  projectedHomeScore    Int?                 @map("projected_home_score")
  projectedAwayScore    Int?                 @map("projected_away_score")
  confidence            PredictionConfidence
  factors               Json                 @db.JsonB
  featureSnapshot       Json                 @map("feature_snapshot") @db.JsonB
  dataAvailability      Json                 @map("data_availability") @db.JsonB
  generatedAt           DateTime             @map("generated_at") @db.Timestamptz(3)
  publishedAt           DateTime?            @map("published_at") @db.Timestamptz(3)
  lockedAt              DateTime?            @map("locked_at") @db.Timestamptz(3)
  evaluatedAt           DateTime?            @map("evaluated_at") @db.Timestamptz(3)
  actualHomeScore       Int?                 @map("actual_home_score")
  actualAwayScore       Int?                 @map("actual_away_score")
  actualWinnerTeamId    String?              @map("actual_winner_team_id") @db.Uuid
  wasCorrect            Boolean?             @map("was_correct")
  brierScore            Float?               @map("brier_score")
  isTie                 Boolean?             @map("is_tie")
  isRetrospective       Boolean              @default(false) @map("is_retrospective")
  aiSummary             String?              @map("ai_summary") @db.VarChar(1000)
  aiKeyReasons          Json?                @map("ai_key_reasons") @db.JsonB
  aiWatchFor            Json?                @map("ai_watch_for") @db.JsonB
  aiProvider            String?              @map("ai_provider") @db.VarChar(64)
  aiModel               String?              @map("ai_model") @db.VarChar(128)
  aiPromptVersion       String?              @map("ai_prompt_version") @db.VarChar(64)
  aiInputTokens         Int?                 @map("ai_input_tokens")
  aiOutputTokens        Int?                 @map("ai_output_tokens")
  aiDurationMs          Int?                 @map("ai_duration_ms")
  generatedById         String?              @map("generated_by_id") @db.Uuid
  generatedBySnapshot   String               @map("generated_by_snapshot") @db.VarChar(254)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                  Game                 @relation(fields: [gameId], references: [id], onDelete: Restrict)
  homeTeam              Team                 @relation("PredictionHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam              Team                 @relation("PredictionAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  predictedWinnerTeam   Team?                @relation("PredictionWinnerTeam", fields: [predictedWinnerTeamId], references: [id], onDelete: Restrict)
  actualWinnerTeam      Team?                @relation("PredictionActualWinnerTeam", fields: [actualWinnerTeamId], references: [id], onDelete: Restrict)
  generatedBy           User?                @relation("PredictionGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([gameId, modelVersion, revision], map: "game_predictions_game_model_revision_key")
  @@index([status, generatedAt], map: "game_predictions_status_generated_idx")
  @@index([gameId, status, revision], map: "game_predictions_game_status_revision_idx")
  @@index([homeTeamId, awayTeamId, status], map: "game_predictions_teams_status_idx")
  @@map("game_predictions")
}

model CurrentGameTeamStat {
  id                    String   @id @default(uuid()) @db.Uuid
  gameId                String   @map("game_id") @db.Uuid
  teamId                String   @map("team_id") @db.Uuid
  isHome                Boolean  @map("is_home")
  firstDowns            Int?     @map("first_downs")
  firstDownsPassing     Int?     @map("first_downs_passing")
  firstDownsRushing     Int?     @map("first_downs_rushing")
  firstDownsPenalty     Int?     @map("first_downs_penalty")
  totalPlays            Int?     @map("total_plays")
  totalYards            Int?     @map("total_yards")
  passingCompletions    Int?     @map("passing_completions")
  passingAttempts       Int?     @map("passing_attempts")
  passingYards          Int?     @map("passing_yards")
  passingInterceptions  Int?     @map("passing_interceptions")
  rushingAttempts       Int?     @map("rushing_attempts")
  rushingYards          Int?     @map("rushing_yards")
  turnovers             Int?
  fumblesLost           Int?     @map("fumbles_lost")
  sacks                 Int?
  sackYardsLost         Int?     @map("sack_yards_lost")
  thirdDownConversions  Int?     @map("third_down_conversions")
  thirdDownAttempts     Int?     @map("third_down_attempts")
  fourthDownConversions Int?     @map("fourth_down_conversions")
  fourthDownAttempts    Int?     @map("fourth_down_attempts")
  penalties             Int?
  penaltyYards          Int?     @map("penalty_yards")
  possessionSeconds     Int?     @map("possession_seconds")
  redZoneConversions    Int?     @map("red_zone_conversions")
  redZoneAttempts       Int?     @map("red_zone_attempts")
  totalDrives           Int?     @map("total_drives")
  period1Score          Int?     @map("period_1_score")
  period2Score          Int?     @map("period_2_score")
  period3Score          Int?     @map("period_3_score")
  period4Score          Int?     @map("period_4_score")
  overtime1Score        Int?     @map("overtime_1_score")
  overtime2Score        Int?     @map("overtime_2_score")
  sourceProvider        String   @map("source_provider") @db.VarChar(64)
  sourceUpdatedAt       DateTime @map("source_updated_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                  Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team                  Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([gameId, teamId], map: "current_game_team_stats_game_team_key")
  @@unique([gameId, isHome], map: "current_game_team_stats_game_side_key")
  @@index([teamId, gameId], map: "current_game_team_stats_team_game_idx")
  @@map("current_game_team_stats")
}

model CurrentGamePlayerStat {
  id                   String   @id @default(uuid()) @db.Uuid
  gameId               String   @map("game_id") @db.Uuid
  teamId               String   @map("team_id") @db.Uuid
  playerId             String   @map("player_id") @db.Uuid
  passingCompletions   Int?     @map("passing_completions")
  passingAttempts      Int?     @map("passing_attempts")
  passingYards         Int?     @map("passing_yards")
  passingTouchdowns    Int?     @map("passing_touchdowns")
  passingInterceptions Int?     @map("passing_interceptions")
  sacksSuffered        Int?     @map("sacks_suffered")
  sackYardsLost        Int?     @map("sack_yards_lost")
  rushingAttempts      Int?     @map("rushing_attempts")
  rushingYards         Int?     @map("rushing_yards")
  rushingTouchdowns    Int?     @map("rushing_touchdowns")
  longestRush          Int?     @map("longest_rush")
  targets              Int?
  receptions           Int?
  receivingYards       Int?     @map("receiving_yards")
  receivingTouchdowns  Int?     @map("receiving_touchdowns")
  longestReception     Int?     @map("longest_reception")
  fumbles              Int?
  fumbleRecoveries     Int?     @map("fumble_recoveries")
  tacklesTotal         Int?     @map("tackles_total")
  tacklesSolo          Int?     @map("tackles_solo")
  defensiveSacks       Float?   @map("defensive_sacks")
  tacklesForLoss       Int?     @map("tackles_for_loss")
  passesDefended       Int?     @map("passes_defended")
  defensiveTouchdowns  Int?     @map("defensive_touchdowns")
  fieldGoalsMade       Int?     @map("field_goals_made")
  fieldGoalsAttempted  Int?     @map("field_goals_attempted")
  longestFieldGoal     Int?     @map("longest_field_goal")
  extraPointsMade      Int?     @map("extra_points_made")
  extraPointsAttempted Int?     @map("extra_points_attempted")
  punts                Int?
  puntYards            Int?     @map("punt_yards")
  puntAverage          Float?   @map("punt_average")
  puntsInside20        Int?     @map("punts_inside_20")
  puntTouchbacks       Int?     @map("punt_touchbacks")
  longestPunt          Int?     @map("longest_punt")
  kickReturns          Int?     @map("kick_returns")
  kickReturnYards      Int?     @map("kick_return_yards")
  kickReturnTouchdowns Int?     @map("kick_return_touchdowns")
  longestKickReturn    Int?     @map("longest_kick_return")
  puntReturns          Int?     @map("punt_returns")
  puntReturnYards      Int?     @map("punt_return_yards")
  puntReturnTouchdowns Int?     @map("punt_return_touchdowns")
  longestPuntReturn    Int?     @map("longest_punt_return")
  sourceProvider       String   @map("source_provider") @db.VarChar(64)
  sourceUpdatedAt      DateTime @map("source_updated_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                 Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team                 Team     @relation("TeamCurrentGamePlayerStats", fields: [teamId], references: [id], onDelete: Restrict)
  player               Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([gameId, playerId], map: "current_game_player_stats_game_player_key")
  @@index([gameId, teamId], map: "current_game_player_stats_game_team_idx")
  @@index([playerId, gameId], map: "current_game_player_stats_player_game_idx")
  @@map("current_game_player_stats")
}

model CurrentGamePlayerStatCoverage {
  id              String   @id @default(uuid()) @db.Uuid
