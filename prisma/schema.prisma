  riskFlags                  String[]                 @map("risk_flags")
  overlapStatus              StoryOverlapStatus       @map("overlap_status")
  closestCandidateId         String?                  @map("closest_candidate_id") @db.Uuid
  closestArticleId           String?                  @map("closest_article_id") @db.Uuid
  duplicateScore             Float?                   @map("duplicate_score")
