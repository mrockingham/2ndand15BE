generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum League {
  NFL
}

enum Conference {
  AFC
  NFC
}

enum Division {
  East
  North
  South
  West
}

enum SeasonType {
  PRE
  REG
  POST
}

enum GameStatus {
  SCHEDULED
  PREGAME
  IN_PROGRESS
  HALFTIME
  FINAL
  POSTPONED
  CANCELED
  SUSPENDED
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum GameSourceType {
  MANUAL_IMPORT
  MANUAL_ENTRY
  OFFICIAL_WEB
  PROVIDER
  EDITORIAL_OVERRIDE
  DEVELOPMENT_FIXTURE
}

enum ArticleType {
  ORIGINAL
  CURATED
  ANNOUNCEMENT
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum NewsSourceKind {
  RSS
  ATOM
  MANUAL_ONLY
}

enum NewsSourceStatus {
  ACTIVE
  PAUSED
  DISABLED
  ERROR
}

enum NewsCandidateStatus {
  NEW
  REVIEWING
  SAVED
  CONVERTED
  DISMISSED
}

enum NewsIngestionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum HistoricalDatasetKind {
  PLAYERS
  WEEKLY_ROSTERS
  PLAYER_STATS
  SCHEDULES
}

enum HistoricalImportStatus {
  RUNNING
  DRY_RUN
  SUCCEEDED
  PARTIAL
  FAILED
}

enum PlayerSeasonSummaryType {
  REG
  POST
  REG_POST
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  email               String                  @db.VarChar(254)
  normalizedEmail     String                  @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(254)
  passwordHash        String                  @map("password_hash") @db.VarChar(255)
  displayName         String?                 @map("display_name") @db.VarChar(80)
  isActive            Boolean                 @default(true) @map("is_active")
  role                UserRole                @default(USER)
  favoriteTeamId      String?                 @map("favorite_team_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  favoriteTeam        Team?                   @relation("UserFavoriteTeam", fields: [favoriteTeamId], references: [id], onDelete: SetNull)
  verifiedProvenances GameProvenance[]        @relation("GameProvenanceVerifier")
  createdOverrides    GameEditorialOverride[] @relation("GameOverrideCreator")
  updatedOverrides    GameEditorialOverride[] @relation("GameOverrideUpdater")
  auditEvents         AdminAuditEvent[]       @relation("AdminAuditActor")
  createdArticles     Article[]               @relation("ArticleCreator")
  updatedArticles     Article[]               @relation("ArticleUpdater")
  articleRevisions    ArticleRevision[]       @relation("ArticleRevisionEditor")
  createdNewsSources  NewsSource[]            @relation("NewsSourceCreator")
  updatedNewsSources  NewsSource[]            @relation("NewsSourceUpdater")
  reviewedCandidates  NewsCandidate[]         @relation("NewsCandidateReviewer")
  newsIngestionRuns   NewsIngestionRun[]      @relation("NewsIngestionInitiator")

  @@index([isActive], map: "users_active_idx")
  @@index([favoriteTeamId], map: "users_favorite_team_id_idx")
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_state_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_hash_key") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt], map: "password_reset_tokens_user_state_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model Team {
  id                       String                @id @default(uuid()) @db.Uuid
  league                   League
  city                     String                @db.VarChar(64)
  name                     String                @db.VarChar(64)
  fullName                 String                @map("full_name") @db.VarChar(128)
  abbreviation             String                @db.VarChar(8)
  conference               Conference
  division                 Division
  primaryColor             String                @map("primary_color") @db.VarChar(7)
  secondaryColor           String                @map("secondary_color") @db.VarChar(7)
  logoUrl                  String?               @map("logo_url") @db.Text
  logoSource               String?               @map("logo_source") @db.VarChar(128)
  isActive                 Boolean               @default(true) @map("is_active")
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  providerMaps             TeamProviderMapping[]
  homeGames                Game[]                @relation("HomeTeamGames")
  awayGames                Game[]                @relation("AwayTeamGames")
  favoritedBy              User[]                @relation("UserFavoriteTeam")
  articles                 ArticleTeam[]
  defaultNewsSources       NewsSource[]
  newsCandidateSuggestions NewsCandidateTeam[]
  latestPlayers            Player[]              @relation("PlayerLatestTeam")
  draftedPlayers           Player[]              @relation("PlayerDraftTeam")
  weeklyPlayerRosters      PlayerWeekRoster[]
  playerGameStats          PlayerGameStat[]      @relation("PlayerStatTeam")
  opponentPlayerGameStats  PlayerGameStat[]      @relation("PlayerStatOpponent")

  @@unique([league, abbreviation], map: "teams_league_abbreviation_key")
  @@index([league, isActive, conference, division, fullName], map: "teams_catalog_order_idx")
  @@map("teams")
}

model Game {
  id                    String                 @id @default(uuid()) @db.Uuid
  league                League
  season                Int
  seasonType            SeasonType             @map("season_type")
  week                  Int?
  startTime             DateTime?              @map("start_time") @db.Timestamptz(3)
  status                GameStatus
  homeTeamId            String                 @map("home_team_id") @db.Uuid
  awayTeamId            String                 @map("away_team_id") @db.Uuid
  homeScore             Int?                   @map("home_score")
  awayScore             Int?                   @map("away_score")
  quarter               Int?
  clock                 String?                @db.VarChar(16)
  venueName             String?                @map("venue_name") @db.VarChar(160)
  venueCity             String?                @map("venue_city") @db.VarChar(128)
  broadcastNetwork      String?                @map("broadcast_network") @db.VarChar(64)
  isNeutralSite         Boolean                @default(false) @map("is_neutral_site")
  providerLastUpdatedAt DateTime?              @map("provider_last_updated_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  homeTeam              Team                   @relation("HomeTeamGames", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam              Team                   @relation("AwayTeamGames", fields: [awayTeamId], references: [id], onDelete: Restrict)
  providerMaps          GameProviderMapping[]
  provenance            GameProvenance?
  editorialOverride     GameEditorialOverride?
  playerStats           PlayerGameStat[]

  @@index([league, season, seasonType, week, startTime], map: "games_schedule_idx")
  @@index([status, startTime], map: "games_status_start_time_idx")
  @@index([homeTeamId, startTime], map: "games_home_team_start_time_idx")
  @@index([awayTeamId, startTime], map: "games_away_team_start_time_idx")
  @@map("games")
}

model GameProvenance {
  id                String         @id @default(uuid()) @db.Uuid
  gameId            String         @unique(map: "game_provenances_game_id_key") @map("game_id") @db.Uuid
  sourceType        GameSourceType @map("source_type")
  sourceName        String         @map("source_name") @db.VarChar(160)
  sourceUrl         String?        @map("source_url") @db.Text
  externalReference String?        @map("external_reference") @db.VarChar(256)
  notes             String?        @db.VarChar(1000)
  importedAt        DateTime       @default(now()) @map("imported_at") @db.Timestamptz(3)
  verifiedAt        DateTime?      @map("verified_at") @db.Timestamptz(3)
  verifiedById      String?        @map("verified_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  game              Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  verifiedBy        User?          @relation("GameProvenanceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([sourceName, externalReference], map: "game_provenances_source_reference_key")
  @@index([sourceType, importedAt], map: "game_provenances_source_imported_idx")
  @@index([verifiedById], map: "game_provenances_verified_by_idx")
  @@map("game_provenances")
}

model GameEditorialOverride {
  id                   String      @id @default(uuid()) @db.Uuid
  gameId               String      @unique(map: "game_editorial_overrides_game_id_key") @map("game_id") @db.Uuid
  startTime            DateTime?   @map("start_time") @db.Timestamptz(3)
  status               GameStatus?
  week                 Int?
  venueName            String?     @map("venue_name") @db.VarChar(160)
  venueCity            String?     @map("venue_city") @db.VarChar(128)
  broadcastNetwork     String?     @map("broadcast_network") @db.VarChar(64)
  isNeutralSite        Boolean?    @map("is_neutral_site")
  publicCorrectionNote String?     @map("public_correction_note") @db.VarChar(500)
  internalNote         String?     @map("internal_note") @db.VarChar(1000)
  createdById          String?     @map("created_by_id") @db.Uuid
  updatedById          String?     @map("updated_by_id") @db.Uuid
  createdBySnapshot    String      @map("created_by_snapshot") @db.VarChar(254)
  updatedBySnapshot    String      @map("updated_by_snapshot") @db.VarChar(254)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                 Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy            User?       @relation("GameOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?       @relation("GameOverrideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById], map: "game_editorial_overrides_created_by_idx")
  @@index([updatedById], map: "game_editorial_overrides_updated_by_idx")
  @@map("game_editorial_overrides")
}

model AdminAuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  actorEmailSnapshot String   @map("actor_email_snapshot") @db.VarChar(254)
  action             String   @db.VarChar(96)
  entityType         String   @map("entity_type") @db.VarChar(64)
  entityId           String?  @map("entity_id") @db.VarChar(128)
  beforeSnapshot     Json?    @map("before_snapshot") @db.JsonB
  afterSnapshot      Json?    @map("after_snapshot") @db.JsonB
  requestId          String?  @map("request_id") @db.VarChar(128)
  reason             String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor              User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt, id], map: "admin_audit_events_created_idx")
  @@index([entityType, entityId, createdAt], map: "admin_audit_events_entity_idx")
  @@index([actorUserId, createdAt], map: "admin_audit_events_actor_idx")
  @@map("admin_audit_events")
}

model Article {
  id                      String            @id @default(uuid()) @db.Uuid
  slug                    String            @unique(map: "articles_slug_key") @db.VarChar(160)
  type                    ArticleType
  status                  ArticleStatus     @default(DRAFT)
  version                 Int               @default(1)
  title                   String            @db.VarChar(180)
  summary                 String?           @db.VarChar(1000)
  body                    String?           @db.Text
  sourceName              String?           @map("source_name") @db.VarChar(160)
  sourceUrl               String?           @map("source_url") @db.Text
  sourcePublishedAt       DateTime?         @map("source_published_at") @db.Timestamptz(3)
  heroImageUrl            String?           @map("hero_image_url") @db.Text
  heroImageAlt            String?           @map("hero_image_alt") @db.VarChar(300)
  heroImageAttribution    String?           @map("hero_image_attribution") @db.VarChar(500)
  heroImageAttributionUrl String?           @map("hero_image_attribution_url") @db.Text
  seoTitle                String?           @map("seo_title") @db.VarChar(180)
  seoDescription          String?           @map("seo_description") @db.VarChar(320)
  isFeatured              Boolean           @default(false) @map("is_featured")
  featuredPriority        Int?              @map("featured_priority")
  featuredStartsAt        DateTime?         @map("featured_starts_at") @db.Timestamptz(3)
  featuredEndsAt          DateTime?         @map("featured_ends_at") @db.Timestamptz(3)
  publishedAt             DateTime?         @map("published_at") @db.Timestamptz(3)
  scheduledFor            DateTime?         @map("scheduled_for") @db.Timestamptz(3)
  createdById             String?           @map("created_by_id") @db.Uuid
  updatedById             String?           @map("updated_by_id") @db.Uuid
  createdBySnapshot       String            @map("created_by_snapshot") @db.VarChar(254)
  updatedBySnapshot       String            @map("updated_by_snapshot") @db.VarChar(254)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy               User?             @relation("ArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?             @relation("ArticleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  teams                   ArticleTeam[]
  revisions               ArticleRevision[]
  sourceCandidate         NewsCandidate?

  @@unique([id, version], map: "articles_id_version_key")
  @@index([status, publishedAt, id], map: "articles_status_published_idx")
  @@index([type, publishedAt, id], map: "articles_type_published_idx")
  @@index([isFeatured, featuredPriority, publishedAt, id], map: "articles_featured_idx")
  @@index([scheduledFor, id], map: "articles_scheduled_idx")
  @@index([createdById, createdAt, id], map: "articles_creator_created_idx")
  @@index([updatedAt, id], map: "articles_updated_idx")
  @@map("articles")
}

model ArticleTeam {
  articleId String   @map("article_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([articleId, teamId])
  @@index([teamId, articleId], map: "article_teams_team_article_idx")
  @@map("article_teams")
}

model ArticleRevision {
  id             String   @id @default(uuid()) @db.Uuid
  articleId      String   @map("article_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  editorUserId   String?  @map("editor_user_id") @db.Uuid
  editorSnapshot String   @map("editor_snapshot") @db.VarChar(254)
  snapshot       Json     @db.JsonB
  changeSummary  String?  @map("change_summary") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor         User?    @relation("ArticleRevisionEditor", fields: [editorUserId], references: [id], onDelete: SetNull)

  @@unique([articleId, revisionNumber], map: "article_revisions_article_number_key")
  @@index([articleId, createdAt, id], map: "article_revisions_article_created_idx")
  @@index([editorUserId, createdAt], map: "article_revisions_editor_created_idx")
  @@map("article_revisions")
}

model NewsSource {
  id                      String             @id @default(uuid()) @db.Uuid
  name                    String             @db.VarChar(160)
  slug                    String             @unique(map: "news_sources_slug_key") @db.VarChar(96)
  kind                    NewsSourceKind
  status                  NewsSourceStatus   @default(PAUSED)
  feedUrl                 String?            @map("feed_url") @db.Text
  siteUrl                 String             @map("site_url") @db.Text
  publisherName           String             @map("publisher_name") @db.VarChar(160)
  defaultTeamId           String?            @map("default_team_id") @db.Uuid
  isOfficialLeague        Boolean            @default(false) @map("is_official_league")
  isOfficialTeam          Boolean            @default(false) @map("is_official_team")
  allowsDescriptionUse    Boolean            @default(false) @map("allows_description_use")
  notes                   String?            @db.VarChar(1000)
  lastCheckedAt           DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  lastSuccessfulAt        DateTime?          @map("last_successful_at") @db.Timestamptz(3)
  lastErrorCode           String?            @map("last_error_code") @db.VarChar(96)
  lastErrorSummary        String?            @map("last_error_summary") @db.VarChar(500)
  lastItemCount           Int                @default(0) @map("last_item_count")
  consecutiveFailureCount Int                @default(0) @map("consecutive_failure_count")
  responseEtag            String?            @map("response_etag") @db.VarChar(512)
  responseModified        String?            @map("response_modified") @db.VarChar(256)
  ingestionLeaseId        String?            @map("ingestion_lease_id") @db.Uuid
  ingestionLeaseStartedAt DateTime?          @map("ingestion_lease_started_at") @db.Timestamptz(3)
  createdById             String?            @map("created_by_id") @db.Uuid
  updatedById             String?            @map("updated_by_id") @db.Uuid
  createdBySnapshot       String             @map("created_by_snapshot") @db.VarChar(254)
  updatedBySnapshot       String             @map("updated_by_snapshot") @db.VarChar(254)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  defaultTeam             Team?              @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)
  createdBy               User?              @relation("NewsSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?              @relation("NewsSourceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  candidates              NewsCandidate[]
  ingestionRuns           NewsIngestionRun[]

  @@index([status, name, id], map: "news_sources_status_name_idx")
  @@index([defaultTeamId], map: "news_sources_default_team_idx")
  @@index([createdById], map: "news_sources_created_by_idx")
  @@index([updatedById], map: "news_sources_updated_by_idx")
  @@map("news_sources")
}

model NewsCandidate {
  id                 String              @id @default(uuid()) @db.Uuid
  sourceId           String?             @map("source_id") @db.Uuid
  sourceNameSnapshot String              @map("source_name_snapshot") @db.VarChar(160)
  sourceExternalId   String?             @map("source_external_id") @db.VarChar(512)
  canonicalUrl       String              @map("canonical_url") @db.Text
  canonicalUrlHash   String              @unique(map: "news_candidates_canonical_url_hash_key") @map("canonical_url_hash") @db.Char(64)
  headline           String              @db.VarChar(300)
  sourceDescription  String?             @map("source_description") @db.VarChar(2000)
  sourceAuthor       String?             @map("source_author") @db.VarChar(160)
  sourcePublishedAt  DateTime?           @map("source_published_at") @db.Timestamptz(3)
  discoveredAt       DateTime            @map("discovered_at") @db.Timestamptz(3)
  status             NewsCandidateStatus @default(NEW)
  dismissalReason    String?             @map("dismissal_reason") @db.VarChar(500)
  convertedArticleId String?             @unique(map: "news_candidates_converted_article_id_key") @map("converted_article_id") @db.Uuid
  reviewedById       String?             @map("reviewed_by_id") @db.Uuid
  reviewedBySnapshot String?             @map("reviewed_by_snapshot") @db.VarChar(254)
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  source             NewsSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  suggestedTeams     NewsCandidateTeam[]
  convertedArticle   Article?            @relation(fields: [convertedArticleId], references: [id], onDelete: Restrict)
  reviewedBy         User?               @relation("NewsCandidateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([sourceId, sourceExternalId], map: "news_candidates_source_external_id_key")
  @@index([status, discoveredAt, id], map: "news_candidates_status_discovered_idx")
  @@index([sourceId, discoveredAt, id], map: "news_candidates_source_discovered_idx")
  @@index([sourcePublishedAt, id], map: "news_candidates_published_idx")
  @@index([reviewedById], map: "news_candidates_reviewer_idx")
  @@map("news_candidates")
}

model NewsCandidateTeam {
  candidateId String        @map("candidate_id") @db.Uuid
  teamId      String        @map("team_id") @db.Uuid
  rule        String        @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  candidate   NewsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([candidateId, teamId])
  @@index([teamId, candidateId], map: "news_candidate_teams_team_candidate_idx")
  @@map("news_candidate_teams")
}

model NewsIngestionRun {
  id                  String                 @id @default(uuid()) @db.Uuid
  sourceId            String                 @map("source_id") @db.Uuid
  status              NewsIngestionRunStatus @default(RUNNING)
  startedAt           DateTime               @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?              @map("completed_at") @db.Timestamptz(3)
  fetchedCount        Int                    @default(0) @map("fetched_count")
  createdCount        Int                    @default(0) @map("created_count")
  updatedCount        Int                    @default(0) @map("updated_count")
  skippedCount        Int                    @default(0) @map("skipped_count")
  failedCount         Int                    @default(0) @map("failed_count")
  responseBytes       Int?                   @map("response_bytes")
  responseEtag        String?                @map("response_etag") @db.VarChar(512)
  responseModified    String?                @map("response_modified") @db.VarChar(256)
  errorCode           String?                @map("error_code") @db.VarChar(96)
  errorSummary        String?                @map("error_summary") @db.VarChar(500)
  initiatedById       String?                @map("initiated_by_id") @db.Uuid
