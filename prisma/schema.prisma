  lastName         String?                    @map("last_name") @db.VarChar(80)
  shortName        String?                    @map("short_name") @db.VarChar(80)
  footballName     String?                    @map("football_name") @db.VarChar(80)
  position         String?                    @db.VarChar(16)
  sourcePosition   String?                    @map("source_position") @db.VarChar(32)
  positionGroup    String?                    @map("position_group") @db.VarChar(24)
  birthDate        DateTime?                  @map("birth_date") @db.Date
  heightInches     Int?                       @map("height_inches")
  weightPounds     Int?                       @map("weight_pounds")
  college          String?                    @db.VarChar(160)
  rookieSeason     Int?                       @map("rookie_season")
  lastSeason       Int?                       @map("last_season")
  draftYear        Int?                       @map("draft_year")
  draftRound       Int?                       @map("draft_round")
  draftPick        Int?                       @map("draft_pick")
  draftTeamId      String?                    @map("draft_team_id") @db.Uuid
  draftTeamSource  String?                    @map("draft_team_source") @db.VarChar(16)
  latestTeamId     String?                    @map("latest_team_id") @db.Uuid
  latestTeamSource String?                    @map("latest_team_source") @db.VarChar(16)
  jerseyNumber     Int?                       @map("jersey_number")
  status           String?                    @db.VarChar(32)
  headshotUrl      String?                    @map("headshot_url") @db.Text
  profileSource    String                     @default("nflverse-players") @map("profile_source") @db.VarChar(96)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  draftTeam        Team?                      @relation("PlayerDraftTeam", fields: [draftTeamId], references: [id], onDelete: SetNull)
  latestTeam       Team?                      @relation("PlayerLatestTeam", fields: [latestTeamId], references: [id], onDelete: SetNull)
  externalIds      PlayerExternalIdentifier[]
  weeklyRosters    PlayerWeekRoster[]
  gameStats        PlayerGameStat[]
  seasonStats      PlayerSeasonStat[]
