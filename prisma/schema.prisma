generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum League {
  NFL
}

enum Conference {
  AFC
  NFC
}

enum Division {
  East
  North
  South
  West
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @db.VarChar(254)
  normalizedEmail     String               @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(254)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  displayName         String?              @map("display_name") @db.VarChar(80)
  isActive            Boolean              @default(true) @map("is_active")
  favoriteTeamId      String?              @map("favorite_team_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  favoriteTeam        Team?                @relation("UserFavoriteTeam", fields: [favoriteTeamId], references: [id], onDelete: SetNull)

  @@index([isActive], map: "users_active_idx")
  @@index([favoriteTeamId], map: "users_favorite_team_id_idx")
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_state_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_hash_key") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt], map: "password_reset_tokens_user_state_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model Team {
  id             String                @id @default(uuid()) @db.Uuid
  league         League
  city           String                @db.VarChar(64)
  name           String                @db.VarChar(64)
  fullName       String                @map("full_name") @db.VarChar(128)
  abbreviation   String                @db.VarChar(8)
  conference     Conference
  division       Division
  primaryColor   String                @map("primary_color") @db.VarChar(7)
  secondaryColor String                @map("secondary_color") @db.VarChar(7)
  logoUrl        String?               @map("logo_url") @db.Text
  logoSource     String?               @map("logo_source") @db.VarChar(128)
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  providerMaps   TeamProviderMapping[]
  favoritedBy    User[]                @relation("UserFavoriteTeam")

  @@unique([league, abbreviation], map: "teams_league_abbreviation_key")
  @@index([league, isActive, conference, division, fullName], map: "teams_catalog_order_idx")
  @@map("teams")
}

model TeamProviderMapping {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  provider       String   @db.VarChar(64)
  providerTeamId String   @map("provider_team_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTeamId], map: "team_provider_mappings_provider_id_key")
  @@index([teamId], map: "team_provider_mappings_team_id_idx")
  @@index([teamId, provider], map: "team_provider_mappings_team_provider_idx")
  @@map("team_provider_mappings")
}
